// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }],
      "h": "vim::Left",
      "backspace": "vim::WrappingLeft",
      "j": "vim::Down",
      // "+": "vim::NextLineStart",
      // "enter": "vim::NextLineStart",
      // "-": "vim::PreviousLineStart",
      "shift-tab": "vim::Tab",
      "tab": "vim::Tab",
      "k": "vim::Up",
      "l": "vim::Right",
      "end": "vim::EndOfLine",
      "$": "vim::EndOfLine",
      "^": "vim::FirstNonWhitespace",
      "_": "vim::StartOfLineDownward",
      "G": "vim::EndOfDocument",
      "{": "vim::StartOfParagraph",
      "}": "vim::EndOfParagraph",
      "(": "vim::SentenceBackward",
      ")": "vim::SentenceForward",
      "|": "vim::GoToColumn",

      // Word motions
      "w": "vim::NextWordStart",
      "e": "vim::NextWordEnd",
      "b": "vim::PreviousWordStart",
      "g e": "vim::PreviousWordEnd",
      // Subword motions
      // "w": "vim::NextSubwordStart",
      // "b": "vim::PreviousSubwordStart",
      // "e": "vim::NextSubwordEnd",
      // "g e": "vim::PreviousSubwordEnd",
      "W": ["vim::NextWordStart", { "ignore_punctuation": true }],
      "E": ["vim::NextWordEnd", { "ignore_punctuation": true }],
      "B": ["vim::PreviousWordStart", { "ignore_punctuation": true }],
      // "g shift-e": ["vim::PreviousWordEnd", { "ignore_punctuation": true }],
      "/": "vim::Search",
      "space /": "pane::DeploySearch",
      "?": ["vim::Search", { "backwards": true }],
      "*": "vim::MoveToNext",
      // "*": ["vim::MoveToNext", "editor::ScrollCursorCenter"],
      "#": "vim::MoveToPrevious",
      "n": "vim::MoveToNextMatch",
      "shift-n": "vim::MoveToPreviousMatch",
      "%": "vim::Matching",
      "f": ["vim::PushFindForward", { "before": false, "multiline": true }],
      "t": ["vim::PushFindForward", { "before": true, "multiline": true }],
      "shift-f": [
        "vim::PushFindBackward",
        { "after": false, "multiline": true },
      ],
      "shift-t": [
        "vim::PushFindBackward",
        { "after": true, "multiline": true },
      ],
      "space m m": "vim::PushMark",
      "'": ["vim::PushJump", { "line": true }],
      "`": ["vim::PushJump", { "line": false }],
      ";": "vim::RepeatFind",
      ",": "vim::RepeatFindReversed",
      "ctrl-o": "pane::GoBack",
      "ctrl-i": "pane::GoForward",
      "escape": "vim::SwitchToNormalMode",
      "v": "vim::ToggleVisual",
      "shift-v": "vim::ToggleVisualLine",
      // "ctrl-g": "vim::ShowLocation",
      "ctrl-v": "vim::ToggleVisualBlock",
      "shift-k": "editor::Hover",
      "shift-r": "vim::ToggleReplace",
      "0": "vim::StartOfLine",
      "home": "vim::StartOfLine",
      "ctrl-j": ["workspace::SendKeystrokes", "L z z"],
      "ctrl-k": ["workspace::SendKeystrokes", "H z z"],
      "pagedown": "vim::PageDown",
      "pageup": "vim::PageUp",
      // "ctrl-j": "vim::ScrollDown",
      // "ctrl-k": "vim::ScrollUp",
      // "ctrl-e": "vim::LineDown",
      // "ctrl-y": "vim::LineUp",
      // "g" commands
      // "g shift-r": "vim::PushReplaceWithRegister",
      // "g r r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g g": "vim::StartOfDocument",
      // "g h": "editor::Hover",
      "space g B": "editor::BlameHover",
      "g d": "editor::GoToDefinition",
      "g shift-d": "editor::GoToDeclaration",
      // "g y": "editor::GoToTypeDefinition",
      // "g shift-i": "editor::GoToImplementation",
      // "g x": "editor::OpenUrl",
      "g f": "editor::OpenSelectedFilename",
      // "g n": "vim::SelectNextMatch",
      // "g shift-n": "vim::SelectPreviousMatch",
      "g n": "vim::SelectNext",
      // "space l a": "editor::ToggleCodeActions",
      "g p": "vim::SelectPrevious",
