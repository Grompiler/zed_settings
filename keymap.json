// ═══════════════════════════════════════════════════════════════════════════
//  ~/.config/zed/keymap.json
//
//  base_keymap : "VSCode" (défaut) + vim_mode : true
//  Le socle (enter/tab/backspace/menus/terminal) vient du keymap de base,
//  ce fichier ne contient plus que la couche Doom/Spacemacs.
//
//  LEADER            = space       (VimControl : normal + visual)
//  LEADER SECONDAIRE = ctrl-space  (insert, terminal, panneaux)
//  Navigation panes  = alt-h/j/k/l (partout, terminal inclus)
//  Demi-page centrée = ctrl-j / ctrl-k
//  Autocomplete      = ctrl-j / ctrl-k (suivant / précédent)
//  Début/fin ligne   = ctrl-h / ctrl-l
//  Jumplist centrée  = ctrl-o / ctrl-i
//  Recherche centrée = n / N
//  Docks             = alt-w (ferme celui qui a le focus)
//
//  RECENTRAGE : les sauts de curseur enchainent l'action puis
//  editor::ScrollCursorCenter via action::Sequence. Plus de dependance aux
//  touches du keymap de base, donc rien a reverifier apres une mise a jour.
//  SendKeystrokes ne reste que la ou une touche litterale est indispensable
//  (marks, find sur caractere, enchainements multi-vues).
//
//  Terminal : center pane uniquement (workspace::NewCenterTerminal).
//  On neutralise les raccourcis du terminal docké plus bas.
// ═══════════════════════════════════════════════════════════════════════════
[
  // ═════════════════════════════════════════════════════════════════════════
  //  0. GLOBAL — navigation entre panes, valable partout
  // ═════════════════════════════════════════════════════════════════════════
  {
    "bindings": {
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  1. SCROLL — demi-page + recentrage vertical du curseur
  //     ctrl-j = ctrl-d puis zz    /    ctrl-k = ctrl-u puis zz
  //     Désactivé quand une popup de complétion est ouverte (section 14).
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu && !showing_completions && !showing_code_actions",
    "bindings": {
      "ctrl-j": ["action::Sequence", ["vim::ScrollDown", "editor::ScrollCursorCenter"]],
      "ctrl-k": ["action::Sequence", ["vim::ScrollUp", "editor::ScrollCursorCenter"]]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  1b. FIND multiligne — f / t / F / T continuent sur les lignes suivantes
  //      ; et , héritent automatiquement du flag du dernier find.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "f": ["vim::PushFindForward", { "before": false, "multiline": true }],
      "t": ["vim::PushFindForward", { "before": true, "multiline": true }],
      "shift-f": ["vim::PushFindBackward", { "after": false, "multiline": true }],
      "shift-t": ["vim::PushFindBackward", { "after": true, "multiline": true }]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  2. DOCKS + neutralisation du terminal docké
  //     alt-w    : ferme le dock qui a le focus
  //     ctrl-j   : était workspace::ToggleBottomDock (ouvrait le terminal)
  //     ctrl-o   : était workspace::OpenFiles, il masquait la jumplist
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": null,
      "ctrl-shift-`": null,
      "ctrl-j": null,
      "ctrl-o": null,
      "alt-w": "workspace::CloseActiveDock"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  2b. ctrl-h / ctrl-l : début et fin de ligne
  //      Pas de recentrage : déplacement sur la ligne courante.
  //      ctrl-i : était editor::ShowSignatureHelp dans le keymap de base.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-h": null,
      "ctrl-l": null,
      "ctrl-i": null
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-h": "vim::StartOfLine",
      "ctrl-l": "vim::EndOfLine",

      // Jumplist recentrée.
      "ctrl-o": ["action::Sequence", ["pane::GoBack", "editor::ScrollCursorCenter"]],
      "ctrl-i": ["action::Sequence", ["pane::GoForward", "editor::ScrollCursorCenter"]],

      // Recherche recentree.
      "n": ["action::Sequence", ["vim::MoveToNextMatch", "editor::ScrollCursorCenter"]],
      "shift-n": ["action::Sequence", ["vim::MoveToPreviousMatch", "editor::ScrollCursorCenter"]]

    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-h": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": true, "stop_at_indent": true }],
      "ctrl-l": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": true }]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  3a. LEADER — accès direct
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space space": "command_palette::Toggle",
      "space tab": "pane::AlternateFile",
      "space q q": "zed::Quit",
      "space /": "pane::DeploySearch",
      "space *": ["workspace::SendKeystrokes", "v i w ctrl-shift-f"]
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "space *": "pane::DeploySearch"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  3c. TOGGLE COMMENT — space ;
  //      normal  : commente la ligne courante (gcc)
  //      visual  : commente la sélection
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space ;": ["workspace::SendKeystrokes", "g c c"]
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "space ;": "vim::ToggleComments"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  3d. MOTIONS / OPÉRATEURS vim ajustés
  //      g d  : go to definition + recentrage
  //      Y    : yank du curseur à la fin de ligne (comportement y$)
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g d": ["action::Sequence", ["editor::GoToDefinition", "editor::ScrollCursorCenter"]],
      "g space": null,
      "shift-space": "editor::OpenExcerpts"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "shift-space": "project_panel::Open"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "shift-space": "outline_panel::OpenSelectedEntry"
    }
  },
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "shift-space": "menu::Confirm"
    }
  },
  {
    // Dans le panneau git uniquement : s / S / u / U pour le staging,
    // et space libere (il valait git::ToggleStaged dans le keymap de base).
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "space": null,
      "s": "git::StageFile",
      "shift-s": "git::StageAll",
      "u": "git::UnstageFile",
      "shift-u": "git::UnstageAll",
      "d": ["git::RestoreFile", { "skip_prompt": false }]
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "shift-y": ["workspace::SendKeystrokes", "y $"]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  3e. HARPOON — space m
  //
  //      Slots = onglets épinglés. Un onglet épinglé se range à gauche et
  //      garde sa position, donc pane::ActivateItem N est stable.
  //
  //        space m t   épingler / désépingler l'onglet
  //        space 1..5  aller au slot N
  //
  //      Bookmarks Zed pour marquer une ligne précise :
  //        space m m   poser / retirer un bookmark
  //        space m N   poser un bookmark avec un libellé
  //        space m e   modifier le libellé du bookmark courant
  //        space m l   liste des bookmarks du projet
  //        space m n / p   bookmark suivant / précédent (recentré)
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space m t": "pane::TogglePinTab",
      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space 5": ["pane::ActivateItem", 4],

      "space m m": "editor::ToggleBookmark",
      "space m a": "editor::ToggleBookmarkWithLabel",
      "space m e": "editor::EditBookmark",
      "space m l": "editor::ViewBookmarks",
      "space m c": "workspace::ClearBookmarks",
      "space m n": ["action::Sequence", ["editor::GoToNextBookmark", "editor::ScrollCursorCenter"]],
      "space m p": ["action::Sequence", ["editor::GoToPreviousBookmark", "editor::ScrollCursorCenter"]]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  3b. LEADER — f  FILES
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f p": "project_panel::ToggleFocus",
      "space f g": "git::OpenModifiedFiles",
      "space f s": "workspace::SaveWithoutFormat",
      "space f S": "workspace::SaveAll",
      "space f n": "workspace::NewFile",
      "space f r": ["workspace::SendKeystrokes", "ctrl-shift-e shift-r"],
      "space f d": ["workspace::SendKeystrokes", "ctrl-shift-e shift-d"]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  4. LEADER — b  BUFFERS
  //     La fermeture est unifiée sur space w d (section 13) : pas de
  //     space b d, sinon Zed affiche l'un ou l'autre au hasard dans l'UI.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space b b": "tab_switcher::ToggleAll",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  5. LEADER — w  WINDOWS / PANES
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w /": "pane::SplitVertical",
      "space w -": "pane::SplitHorizontal",
      "space w d": "pane::CloseActiveItem",
      "space w o": "workspace::CloseInactiveTabsAndPanes",
      "space w z": "workspace::ToggleZoom",
      "space w m": "workspace::CloseAllDocks",
      "space w =": "vim::ResetPaneSizes"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  6. LEADER — j  JUMP  (tous recentrés)
  //     Structure via action::Sequence ; arguments via f , (SendKeystrokes).
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space j j": "go_to_line::Toggle",
      "space j f": ["action::Sequence", ["vim::NextMethodStart", "editor::ScrollCursorCenter"]],
      "space j F": ["action::Sequence", ["vim::PreviousMethodStart", "editor::ScrollCursorCenter"]],
      "space j c": ["action::Sequence", ["vim::NextSectionStart", "editor::ScrollCursorCenter"]],
      "space j C": ["action::Sequence", ["vim::PreviousSectionStart", "editor::ScrollCursorCenter"]],
      "space j m": ["action::Sequence", ["vim::NextMethodEnd", "editor::ScrollCursorCenter"]],
      "space j M": ["action::Sequence", ["vim::PreviousMethodEnd", "editor::ScrollCursorCenter"]],
      "space j a": ["workspace::SendKeystrokes", "f , z z"],
      "space j A": ["workspace::SendKeystrokes", "shift-f , z z"],
      "space j p": ["workspace::SendKeystrokes", "f , z z"],
      "space j P": ["workspace::SendKeystrokes", "shift-f , z z"]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  7. LEADER — l  LSP
  //     Sauts recentrés : d, i, t.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space l f": "editor::Format",
      "space l r": "editor::Rename",
      "space l d": ["action::Sequence", ["editor::GoToDefinition", "editor::ScrollCursorCenter"]],
      "space l R": "editor::FindAllReferences",
      "space l i": ["action::Sequence", ["editor::GoToImplementation", "editor::ScrollCursorCenter"]],
      "space l t": ["action::Sequence", ["editor::GoToTypeDefinition", "editor::ScrollCursorCenter"]],
      "space l a": "editor::ToggleCodeActions",
      "space l h": "editor::Hover"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "space l f": "editor::FormatSelections"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  8. LEADER — g  GIT
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space g g": ["workspace::SendKeystrokes", "ctrl-shift-g ctrl-1"],
      "space g c": "git::Commit",
      "space g d": "git::Diff",
      "space g b": "git::Branch",
      "space g B": "git::Blame",
      "space g h": ["workspace::SendKeystrokes", "ctrl-shift-g ctrl-2"],
      "space g s": "git::StageAndNext",
      "space g u": "git::UnstageAndNext",
      "space g p": "git::Push",
      "space g P": "git::Pull",
      "space g f": "git::Fetch"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  8b. Neutralisation des anciens raccourcis de staging du keymap de base.
  //      space g s / space g u les remplacent (section 8) et couvrent aussi
  //      bien la vue git diff qu'un buffer de code ordinaire.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Editor && !agent_diff",
    "bindings": {
      "alt-y": null,
      "shift-alt-y": null
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  9. (SEARCH : voir section 3a — space / et space *)
  // ═════════════════════════════════════════════════════════════════════════

  // ═════════════════════════════════════════════════════════════════════════
  //  10. LEADER — t  TERMINAL (center pane)
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space t t": "workspace::NewCenterTerminal",
      "space t n": "workspace::NewCenterTerminal",
      "space t v": ["workspace::SendKeystrokes", "space w / space t n"],
      "space t s": ["workspace::SendKeystrokes", "space w - space t n"]
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  10b. TERMINAL CENTRÉ — alignement sur les mappings existants
  //       Le terminal est un onglet ordinaire : ctrl-space reprend l'arbre
  //       leader, et on coupe les chemins qui ramèneraient au dock.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": null,
      "ctrl-shift-space": null,
      "escape": "terminal::ToggleViMode",
      "ctrl-shift-5": "pane::SplitVertical",
      "ctrl-shift-6": "pane::SplitHorizontal"
    }
  },
  {
    "context": "Terminal && vi_mode",
    "bindings": {
      "shift-a": "terminal::ToggleViMode",

      // Deplacements alignes sur l'editeur. On rejoue les touches que le
      // mode vi du terminal comprend nativement : ctrl-d / ctrl-u pour la
      // demi-page, 0 et $ pour le debut et la fin de ligne.
      // Pas de z z ici : le mode vi du terminal n'a pas d'equivalent.
      "ctrl-j": ["workspace::SendKeystrokes", "ctrl-d"],
      "ctrl-k": ["workspace::SendKeystrokes", "ctrl-u"],
      "ctrl-h": ["workspace::SendKeystrokes", "0"],
      "ctrl-l": ["workspace::SendKeystrokes", "$"],

      // En mode vi, space n'est plus un caractere saisi : on rejoue
      // l'arbre leader complet pour ne jamais avoir a sortir du terminal.
      "space space": "command_palette::Toggle",
      "space tab": "pane::AlternateFile",
      "space /": "pane::DeploySearch",
      "space q q": "zed::Quit",

      "space f f": "file_finder::Toggle",
      "space f p": "project_panel::ToggleFocus",
      "space f g": "git::OpenModifiedFiles",
      "space f s": "workspace::SaveWithoutFormat",
      "space f S": "workspace::SaveAll",
      "space f n": "workspace::NewFile",

      "space b b": "tab_switcher::ToggleAll",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",

      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w /": "pane::SplitVertical",
      "space w -": "pane::SplitHorizontal",
      "space w d": "pane::CloseActiveItem",
      "space w o": "workspace::CloseInactiveTabsAndPanes",
      "space w z": "workspace::ToggleZoom",
      "space w m": "workspace::CloseAllDocks",
      "space w =": "vim::ResetPaneSizes",

      "space m t": "pane::TogglePinTab",
      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space 5": ["pane::ActivateItem", 4],

      "space g g": "git_panel::ToggleFocus",
      "space g c": "git::Commit",
      "space g d": "git::Diff",
      "space g p": "git::Push",
      "space g P": "git::Pull",
      "space g f": "git::Fetch",

      "space t t": "workspace::NewCenterTerminal",
      "space t n": "workspace::NewCenterTerminal",

      "space e l": "diagnostics::Deploy"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  11. LEADER — e  ERRORS  (sauts recentrés)
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space e n": ["action::Sequence", ["editor::GoToDiagnostic", "editor::ScrollCursorCenter"]],
      "space e p": ["action::Sequence", ["editor::GoToPreviousDiagnostic", "editor::ScrollCursorCenter"]],
      "space e l": "diagnostics::Deploy"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  12. LEADER SECONDAIRE — ctrl-space (terminal, panneaux, insert)
  //      Note : en mode insert, la complétion LSP reste sur ctrl-x ctrl-o
  //      et la complétion de mots sur ctrl-n / ctrl-p (défauts vim).
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Terminal || ProjectPanel || GitPanel || OutlinePanel || (Editor && vim_mode == insert)",
    "bindings": {
      "ctrl-space f f": "file_finder::Toggle",
      "ctrl-space f g": "git::OpenModifiedFiles",
      "ctrl-space f s": "workspace::SaveWithoutFormat",
      "ctrl-space f S": "workspace::SaveAll",
      "ctrl-space f n": "workspace::NewFile",
      "ctrl-space f p": "project_panel::ToggleFocus",

      "ctrl-space b b": "tab_switcher::ToggleAll",
      "ctrl-space b n": "pane::ActivateNextItem",
      "ctrl-space b p": "pane::ActivatePreviousItem",

      "ctrl-space w h": "workspace::ActivatePaneLeft",
      "ctrl-space w j": "workspace::ActivatePaneDown",
      "ctrl-space w k": "workspace::ActivatePaneUp",
      "ctrl-space w l": "workspace::ActivatePaneRight",
      "ctrl-space w /": "pane::SplitVertical",
      "ctrl-space w -": "pane::SplitHorizontal",
      "ctrl-space w d": "pane::CloseActiveItem",
      "ctrl-space w o": "workspace::CloseInactiveTabsAndPanes",
      "ctrl-space w z": "workspace::ToggleZoom",
      "ctrl-space w m": "workspace::CloseAllDocks",
      "ctrl-space w =": "vim::ResetPaneSizes",

      "ctrl-space g g": "git_panel::ToggleFocus",
      "ctrl-space g c": "git::Commit",
      "ctrl-space g d": "git::Diff",
      "ctrl-space g p": "git::Push",
      "ctrl-space g P": "git::Pull",
      "ctrl-space g f": "git::Fetch",

      "ctrl-space /": "pane::DeploySearch",
      "ctrl-space space": "command_palette::Toggle",

      "ctrl-space t t": "workspace::NewCenterTerminal",
      "ctrl-space t n": "workspace::NewCenterTerminal",
      "ctrl-space t v": ["workspace::SendKeystrokes", "ctrl-space w / ctrl-space t n"],
      "ctrl-space t s": ["workspace::SendKeystrokes", "ctrl-space w - ctrl-space t n"],

      "ctrl-space e l": "diagnostics::Deploy"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  13. FERMETURE — déclarée en dernier pour que ce soit ce raccourci
  //      que Zed affiche dans l'UI (onglets, diagnostics, tooltips).
  //      L'action est passée SANS argument : c'est la signature que l'UI
  //      interroge pour afficher un raccourci. Avec { close_pinned: false }
  //      elle ne correspond pas et Zed affiche autre chose.
  //
  //      Le contexte Diagnostics n'herite pas de VimControl : il faut y
  //      redeclarer ce que l'on veut voir fonctionner.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Diagnostics",
    "bindings": {
      "space w d": "pane::CloseActiveItem",
      "space e n": "editor::GoToDiagnostic",
      "space e p": "editor::GoToPreviousDiagnostic"
    }
  },

  // ═════════════════════════════════════════════════════════════════════════
  //  14. AUTOCOMPLETE — ctrl-j / ctrl-k dans les popups
  //      Déclaré en dernier pour l'emporter sur le scroll de la section 1.
  // ═════════════════════════════════════════════════════════════════════════
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious"
    }
  },
  {
    "context": "Editor && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-j": "editor::SignatureHelpNext",
      "ctrl-k": "editor::SignatureHelpPrevious"
